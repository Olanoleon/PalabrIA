# Neon POOLED connection string — the host contains "-pooler". Used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/palabria?sslmode=require"
# Neon DIRECT connection string — same host without "-pooler". Used by
# `prisma migrate`, which needs advisory locks PgBouncer cannot provide.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/palabria?sslmode=require"
# Only needed to author new migrations with `prisma migrate dev`. Leave empty in
# production: `migrate deploy` never uses it.
SHADOW_DATABASE_URL=""

# 32+ char random string — signs the session cookie
AUTH_SECRET=""
# Shared secret the Railway cron must send as x-cron-secret
CRON_SECRET=""

# Server-side only. Never referenced from a client component.
OPENAI_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM="PalabrIA <no-reply@example.com>"
APP_URL="https://palabria.up.railway.app"
