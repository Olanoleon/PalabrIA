# Neon POOLED connection string — the host contains "-pooler". Used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/palabria?sslmode=require"
# Neon DIRECT connection string — the SAME database as above with "-pooler"
# removed from the host. Used by `prisma migrate`, which needs advisory locks
# PgBouncer cannot provide. This must be a real value: Prisma refuses to load
# the schema (P1012) if the variable is missing, and silently misbehaves if it
# points at the pooler. Copy it from Neon's Connect panel with pooling OFF.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Only `prisma migrate dev` uses this, to author new migrations locally.
# OMIT IT ENTIRELY in production — `migrate deploy` never reads it, and an
# unset variable is fine (unlike DIRECT_URL).
SHADOW_DATABASE_URL=""

# Signs the session cookie. Required: auth throws below 32 characters.
#   openssl rand -base64 32
AUTH_SECRET=""
# Shared secret the Railway cron must send as x-cron-secret. Without it
# /api/cron/billing returns 503 and nobody is ever suspended for non-payment.
CRON_SECRET=""

# Server-side only. Never referenced from a client component.
OPENAI_API_KEY=""
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend. Until it is, admin 2FA
# codes cannot be delivered and administrators cannot sign in at all.
RESEND_FROM="PalabrIA <no-reply@yourdomain.com>"
# Your actual Railway domain. Password-reset links are built from this.
APP_URL="https://YOUR-APP.up.railway.app"
